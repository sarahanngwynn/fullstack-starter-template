// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

model ParentAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  parentName   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  children     ChildProfile[]
  drafts       RegistrationDraft[]
}

model ChildProfile {
  id        String   @id @default(cuid())
  parentId  String
  parent    ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)

  name      String
  age       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegistrationDraft {
  id        String   @id @default(cuid())
  parentId  String
  parent    ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)

  // Keep it flexible — store the registration payload as JSON
  data      Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  email     String   @unique @db.VarChar(255)
  role      String   @db.VarChar(255)
  password  String   @db.VarChar(255)
}
model Application {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Basic app info
  siteKey            String   // e.g. "DM-RIVERPARK"
  status             AppStatus          @default(DRAFT)
  procareSyncStatus  ProcareSyncStatus  @default(NOT_SENT)

 
  // store all form data as JSON. You can normalize later.
  childData     Json
  guardiansData Json
  otherData     Json?

  // Payment
  hasPaid       Boolean  @default(false)
  stripePaymentId String? 
}

enum AppStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum ProcareSyncStatus {
  NOT_SENT
  PENDING
  SENT
  FAILED
}

